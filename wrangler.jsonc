{
  "name": "my-projects",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chat-db",
      "database_id": "aaa7a3da-1273-4443-9bbd-8936d5b1764a"
    }
  ]
}
